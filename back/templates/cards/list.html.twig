{% extends 'base.html.twig' %}

{% block title %}Liste des cartes{% endblock %}

{% block body %}
    <h1>Ma liste de cartes</h1>
    {% for card in cards %}
    <p>{{ card.name }}</p>
    <p>{{ card.rarity }}</p>
    <p>{{ card.type }}</p>
    <p>{{ card.description }}</p>
    <p><img src="{{ card.image }}" alt="{{ card.name }}" width="100"></p>
    <a href="{{ path('card_edit', {'id': card.id}) }}">Modifier</a>
    <form method="post" action="{{ path('card_delete', {'id': card.id}) }}"onsubmit="return confirm('Êtes-vous sûr ?')">
        <button type="submit">Supprimer</button>
    </form>
    <hr>
{% endfor %}
{% endblock %}